{
  "name": "wordseye",
  "private": true,
  "version": "0.1.0",
  "description": "A fast, daily word-association game: get warmer, hit the bullseye.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:fetch": "tsx scripts/fetch-vectors.ts",
    "data:vectors": "tsx scripts/blend-vectors.ts",
    "data:targets": "tsx scripts/find-targets.ts",
    "data:build": "tsx scripts/build-puzzles.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wordlist-english": "^1.2.1"
  }
}
